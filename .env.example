APP_NAME="Acufara Klinik & Spa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE (PostgreSQL — Docker Service: db)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=acufara_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# ============================================================
# DATABASE OPTIONS (Supabase Pooler Compatibility)
# ============================================================
# Set DB_EMULATE_PREPARES=true saat menggunakan Supavisor (port 6543)
# untuk mencegah error "prepared statement does not exist".
# Direct connection (port 5432) tidak memerlukan setting ini.
DB_EMULATE_PREPARES=true
DB_SSLMODE=prefer

# ============================================================
# CACHE & SESSION
# ============================================================
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ============================================================
# MAIL (Mailpit untuk Development)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@acufara.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# STORAGE (Ubah ke 'gcs' saat deploy ke Cloud Run)
# ============================================================
FILESYSTEM_DISK=public

# ============================================================
# GOOGLE CLOUD STORAGE (Persiapan Produksi)
# ============================================================
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=acufara-media-bucket
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
# Jika pakai service account key (JSON):
GOOGLE_CLOUD_KEY_FILE=

# ============================================================
# AI INTEGRATION — Google Gemini API
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
#
# GEMINI_API_KEY     : API Key dari Google AI Studio (wajib diisi).
# GEMINI_DEFAULT_MODEL: Model Gemini yang digunakan.
#   - Rekomendasi dev  : gemini-1.5-flash  (cepat, kuota gratis lebih besar)
#   - Rekomendasi prod : gemini-1.5-pro    (lebih akurat untuk teks medis)
#
# Fitur yang menggunakan key ini:
#   - AcuVoice (Langkah 13): Format raw transcript → SOAP Note
#   - Smart Triage (Langkah 14): Analisis keluhan pasien + saran rute
# ============================================================
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ============================================================
# FONNTE WHATSAPP OTP CONFIGURATION
# Token Fonnte untuk mengirimkan pesan WhatsApp secara otomatis.
# Kosongkan jika sedang di local/development agar OTP hanya dicetak di Log.
# ============================================================
FONNTE_TOKEN=

# ============================================================
# TELEGRAM NOTIFICATION (Notifikasi Booking ke Klinik/Admin)
# Kanal notifikasi booking baru. Menggantikan notifikasi via Fonnte
# karena nomor WhatsApp pengirim berisiko diblokir Meta.
#
# TELEGRAM_BOT_TOKEN      : Token dari @BotFather.
# TELEGRAM_DEFAULT_CHAT_ID: Chat/grup tujuan untuk booking Homecare, dan
#                           fallback untuk cabang yang belum punya chat_id.
#                           Untuk tipe Klinik, tujuan diambil dari kolom
#                           branches.telegram_chat_id (diisi via panel admin).
#
# Cara setup:
#   1. Buat bot di https://t.me/BotFather → dapatkan token.
#   2. Buat grup (mis. "Acufara Ops"), masukkan bot ke grup.
#   3. Kirim satu pesan apa pun di grup tersebut.
#   4. Ambil chat_id (jalankan sekali dari laptop, BUKAN dari aplikasi):
#        curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#          | jq '.result[].message.chat'
#   5. Salin nilai "id" (grup bernilai negatif, supergroup berawalan -100).
#
# Kosongkan TELEGRAM_BOT_TOKEN di local/development agar pesan hanya dicetak
# ke log tanpa benar-benar dikirim.
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ============================================================
# FONNTE MONITORING
# Sistem monitoring yang mengecek status Fonntee secara berkala
# dan mengirim email notifikasi jika terputus.
#
# FONNTE_CHECK_ENABLED  : Aktifkan monitoring (true/false).
# FONNTE_CHECK_SECRET   : Token rahasia untuk autentikasi endpoint.
# FONNTE_CHECK_INTERVAL : Interval pengecekan dalam menit (default: 5).
# FONNTE_EMAIL_THROTTLE : Jeda minimum antar email dalam menit (default: 30).
# MONITORING_EMAIL      : Email tujuan notifikasi jika Fonntee terputus.
#
# Untuk production, gunakan Gmail SMTP (bukan Mailpit):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-app-password
#   MAIL_ENCRYPTION=tls
#
# Cara buat Gmail App Password:
#   1. Buka Google Account → Security
#   2. Aktifkan 2-Step Verification
#   3. Buka App Passwords
#   4. Buat password untuk "Acufara Monitoring"
# ============================================================
FONNTE_CHECK_ENABLED=false
FONNTE_CHECK_SECRET=
FONNTE_CHECK_INTERVAL=5
FONNTE_EMAIL_THROTTLE=30
MONITORING_EMAIL=

# ============================================================
# DEFAULT DEVELOPMENT ADMIN
# ============================================================
SUPERADMIN_EMAIL=admin@acufara.test
SUPERADMIN_PASSWORD=password
SUPERADMIN_WHATSAPP=6281234567890

