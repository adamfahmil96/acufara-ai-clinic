APP_NAME="Acufara Klinik & Spa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE (PostgreSQL — Docker Service: db)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=acufara_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# ============================================================
# DATABASE OPTIONS (Supabase Pooler Compatibility)
# ============================================================
# Set DB_EMULATE_PREPARES=true saat menggunakan Supavisor (port 6543)
# untuk mencegah error "prepared statement does not exist".
# Direct connection (port 5432) tidak memerlukan setting ini.
DB_EMULATE_PREPARES=true
DB_SSLMODE=prefer

# ============================================================
# CACHE & SESSION
# ============================================================
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ============================================================
# MAIL (Mailpit untuk Development)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@acufara.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# STORAGE (Ubah ke 'gcs' saat deploy ke Cloud Run)
# ============================================================
FILESYSTEM_DISK=public

# ============================================================
# GOOGLE CLOUD STORAGE (Persiapan Produksi)
# ============================================================
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=acufara-media-bucket
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
# Jika pakai service account key (JSON):
GOOGLE_CLOUD_KEY_FILE=

# ============================================================
# AI INTEGRATION — Google Gemini API
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
#
# GEMINI_API_KEY     : API Key dari Google AI Studio (wajib diisi).
# GEMINI_DEFAULT_MODEL: Model Gemini yang digunakan.
#   - Rekomendasi dev  : gemini-1.5-flash  (cepat, kuota gratis lebih besar)
#   - Rekomendasi prod : gemini-1.5-pro    (lebih akurat untuk teks medis)
#
# Fitur yang menggunakan key ini:
#   - AcuVoice (Langkah 13): Format raw transcript → SOAP Note
#   - Smart Triage (Langkah 14): Analisis keluhan pasien + saran rute
# ============================================================
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ============================================================
# FONNTE WHATSAPP OTP CONFIGURATION
# Token Fonnte untuk mengirimkan pesan WhatsApp secara otomatis.
# Kosongkan jika sedang di local/development agar OTP hanya dicetak di Log.
# ============================================================
FONNTE_TOKEN=

# ============================================================
# DEFAULT DEVELOPMENT ADMIN
# ============================================================
SUPERADMIN_EMAIL=admin@acufara.test
SUPERADMIN_PASSWORD=password
SUPERADMIN_WHATSAPP=6281234567890

